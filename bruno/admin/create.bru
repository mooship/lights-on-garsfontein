meta {
  name: create a past outage
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/admin/outages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminApiToken}}
}

body:json {
  {
    "action": "create",
    "startTime": "2026-10-17T05:52:00+02:00",
    "endTime": "2026-10-17T11:15:00+02:00"
  }
}

vars:post-response {
  createdId: res.body.outage.id
}

tests {
  test('201 with the times in UTC, unplanned', () => {
    expect(res.getStatus()).to.equal(201);
    const { outage } = res.getBody();
    expect(outage.startTime).to.equal('2026-10-17T03:52:00.000Z');
    expect(outage.endTime).to.equal('2026-10-17T09:15:00.000Z');
    expect(outage.isPlanned).to.equal(false);
  });
}
