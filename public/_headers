# HSTS is the default for any deployment; this one's Cloudflare zone sets its own, which replaces it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-TNDnPEXAcIN6YTi2yrgtdVv8btQG4x/RL+UAGDPMMMI=' 'sha256-ooB+dHBW3cOC1q8V2tMH2dkTpudeEprRSoqnC/t05CI=' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin

# Crawlable so search engines can see the noindex (robots.txt would hide it from them).
/admin
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed, but they rarely change: a day saves a check on every visit and icon swap.
/favicon*
  Cache-Control: public, max-age=86400

# Browsers must see a new copy at once (public/sw.js says why).
/sw.js
  Cache-Control: no-cache

/og/*
  Cache-Control: public, max-age=3600
