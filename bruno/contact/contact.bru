meta {
  name: contact
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/contact
  body: json
}

body:json {
  {
    "token": "test-token"
  }
}

tests {
  // Local Turnstile uses Cloudflare's always-pass test keys, so any token is accepted.
  test('200 JSON with the contact address, not cached', () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader('content-type')).to.equal('application/json; charset=utf-8');
    expect(res.getHeader('cache-control')).to.equal('no-store');
    expect(res.getBody().email).to.include('@');
  });
}
