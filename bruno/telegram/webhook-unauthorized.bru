meta {
  name: webhook without the secret
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/telegram
  body: json
}

body:json {
  {
    "update_id": 1,
    "message": { "message_id": 1, "chat": { "id": 1, "type": "private" }, "date": 0, "text": "/status" }
  }
}

tests {
  test('401 unauthorized', () => {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: 'unauthorized' });
  });
}
