# Copy to .dev.vars for local development. These are Cloudflare's public
# Turnstile test keys (always pass), username "admin", a hash of the password "test-password" and a
# placeholder contact address (the real one is the CONTACT_EMAIL secret).
# Keep this order: `wrangler types --check` in CI reads it, and the order shapes the generated types.
SITE_URL="http://localhost:8787"
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
ADMIN_PASSWORD_HASH='pbkdf2_sha256$100000$n7SohUIkjgbP01xFrUR50w==$G4dp7lkqVXazO3SBFzPjLKXgdzhDeh99ZXefTHRlxEg='
HEARTBEAT_TOKEN="local-heartbeat-token"
ADMIN_API_TOKEN="local-admin-api-token"
ADMIN_USERNAME="admin"
CONTACT_EMAIL="contact@example.invalid"
VAPID_PRIVATE_KEY='{"key_ops":["sign"],"ext":true,"kty":"EC","x":"-3Hp4KVoMjPEi9JbtKlFpP-QnlseRduXTOFZdyXyA20","y":"eDeNwmF2tJG0I2WpQfhHy5ydPHz6zyO7bzffyHoNzjQ","crv":"P-256","d":"9dxzmBrrYXeQGoMXkFCuPw3hGBggRaDrc4ffWOBJyrE"}'
