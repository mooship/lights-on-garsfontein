meta {
  name: login with a wrong password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/login
  body: json
}

body:json {
  {
    "username": "{{adminUsername}}",
    "password": "wrong-password",
    "token": "test-token"
  }
}

tests {
  test('401 unauthorized, no session', () => {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: 'unauthorized' });
    expect(res.getHeader('set-cookie')).to.equal(undefined);
  });
}
